{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": ["server.ts", "src/**/*.ts", "hooks/**/*.ts", "bin/**/*.ts", "test/**/*.ts"]
}
